enum class AppScreen {
    SPLASH,
    INTRO,
    HOME,
    SEND_PREPARATION,
    RECEIVE_PREPARATION,
    NEARBY_DEVICES,
    TRANSFER_HISTORY,
    SETTINGS,
    HELP
}

class MainActivity : ComponentActivity() {
    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)

        val defaultDeviceName = "${Build.MANUFACTURER.replaceFirstChar { it.uppercase() }} ${Build.MODEL}"

        setContent {
            var currentLanguage by remember { mutableStateOf(AppLanguage.HINDI) }
            var isDarkMode by remember { mutableStateOf(true) }
            var showFirstTimeIntro by remember { mutableStateOf(true) }
            var currentScreen by remember { mutableStateOf(AppScreen.SPLASH) }
            var customDeviceName by remember { mutableStateOf(defaultDeviceName) }

            val strings = AppStringsProvider.get(currentLanguage)

            LaunchedEffect(Unit) {
                delay(1400)
                currentScreen = if (showFirstTimeIntro) AppScreen.INTRO else AppScreen.HOME
            }

            FileBridgeTheme(darkTheme = isDarkMode) {
                Surface(
                    modifier = Modifier.fillMaxSize(),
                    color = MaterialTheme.colorScheme.background
                ) {
                    when (currentScreen) {
                        AppScreen.SPLASH -> SplashScreen(strings)
                        AppScreen.INTRO -> FirstTimeIntroScreen(
                            strings = strings,
                            currentLanguage = currentLanguage,
                            onLanguageToggle = {
                                currentLanguage = if (currentLanguage == AppLanguage.HINDI) AppLanguage.ENGLISH else AppLanguage.HINDI
                            },
                            onContinue = {
                                showFirstTimeIntro = false
                                currentScreen = AppScreen.HOME
                            }
                        )
                        else -> MainScaffoldContainer(
                            currentScreen = currentScreen,
                            onNavigate = { currentScreen = it },
                            strings = strings,
                            currentLanguage = currentLanguage,
                            onLanguageChange = { currentLanguage = it },
                            isDarkMode = isDarkMode,
                            onThemeToggle = { isDarkMode = it },
                            deviceName = customDeviceName,
                            onDeviceNameChange = { customDeviceName = it }
                        )
                    }
                }
            }
        }
    }
}


class MainActivity : ComponentActivity() {

    private var wifiP2pManager: WifiP2pManager? = null
    private var wifiChannel: WifiP2pManager.Channel? = null
    private var p2pReceiver: BroadcastReceiver? = null

    val nearbyPeers = mutableStateListOf<WifiP2pDevice>()
    var p2pStatusText by mutableStateOf("P2P Ready")
    var connectedHostIp by mutableStateOf("")
    var isGroupOwner by mutableStateOf(false)

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)

        wifiP2pManager = getSystemService(Context.WIFI_P2P_SERVICE) as? WifiP2pManager
        wifiChannel = wifiP2pManager?.initialize(this, mainLooper, null)

        setContent {
            var isDarkTheme by remember { mutableStateOf(true) }
            var isHindi by remember { mutableStateOf(true) }

            val colorScheme = if (isDarkTheme) {
                darkColorScheme(
                    primary = Color(0xFF6366F1),
                    secondary = Color(0xFFA855F7),
                    background = Color(0xFF0B0F19),
                    surface = Color(0xFF161F30),
                    onBackground = Color.White,
                    onSurface = Color.White,
                    onSurfaceVariant = Color(0xFF94A3B8)
                )
            } else {
                lightColorScheme(
                    primary = Color(0xFF4F46E5),
                    secondary = Color(0xFF9333EA),
                    background = Color(0xFFF8FAFC),
                    surface = Color.White,
                    onBackground = Color(0xFF0F172A),
                    onSurface = Color(0xFF0F172A),
                    onSurfaceVariant = Color(0xFF475569)
                )
            }

            MaterialTheme(colorScheme = colorScheme) {
                Surface(
                    modifier = Modifier.fillMaxSize(),
                    color = MaterialTheme.colorScheme.background
                ) {
                    SafeP2PMainApp(
                        isDarkTheme = isDarkTheme,
                        onToggleTheme = { isDarkTheme = !isDarkTheme },
                        isHindi = isHindi,
                        onToggleLang = { isHindi = !isHindi },
                        peers = nearbyPeers,
                        p2pStatus = p2pStatusText,
                        detectedHostIp = connectedHostIp,
                        isGroupOwner = isGroupOwner,
                        onStartDiscovery = { startPeerDiscovery() },
                        onConnectPeer = { device -> connectToPeer(device) }
                    )
                }
            }
        }
    }

    @SuppressLint("MissingPermission")
    fun startPeerDiscovery() {
        val manager = wifiP2pManager ?: return
        val channel = wifiChannel ?: return
        p2pStatusText = "Scanning..."
        try {
            manager.discoverPeers(channel, object : WifiP2pManager.ActionListener {
                override fun onSuccess() {
                    p2pStatusText = "Radar Active"
                }

                override fun onFailure(reason: Int) {
                    p2pStatusText = "Scan Mode ($reason)"
                }
            })
        } catch (e: Exception) {
            p2pStatusText = "Permission Needed"
        }
    }

    @SuppressLint("MissingPermission")
    fun connectToPeer(device: WifiP2pDevice) {
        val manager = wifiP2pManager ?: return
        val channel = wifiChannel ?: return
        val config = WifiP2pConfig().apply {
            deviceAddress = device.deviceAddress
        }
        p2pStatusText = "Connecting: ${device.deviceName}"
        try {
            manager.connect(channel, config, object : WifiP2pManager.ActionListener {
                override fun onSuccess() {
                    p2pStatusText = "Connected: ${device.deviceName}"
                }

                override fun onFailure(reason: Int) {
                    p2pStatusText = "Conn Failed ($reason)"
                }
            })
        } catch (e: Exception) {
            p2pStatusText = "Conn Error"
        }
    }

    override fun onResume() {
        super.onResume()
        val filter = IntentFilter().apply {
            addAction(WifiP2pManager.WIFI_P2P_STATE_CHANGED_ACTION)
            addAction(WifiP2pManager.WIFI_P2P_PEERS_CHANGED_ACTION)
            addAction(WifiP2pManager.WIFI_P2P_CONNECTION_CHANGED_ACTION)
            addAction(WifiP2pManager.WIFI_P2P_THIS_DEVICE_CHANGED_ACTION)
        }
        p2pReceiver = object : BroadcastReceiver() {
            @SuppressLint("MissingPermission")
            override fun onReceive(context: Context?, intent: Intent?) {
                when (intent?.action) {
                    WifiP2pManager.WIFI_P2P_PEERS_CHANGED_ACTION -> {
                        val manager = wifiP2pManager ?: return
                        val channel = wifiChannel ?: return
                        try {
                            manager.requestPeers(channel) { peerList ->
                                nearbyPeers.clear()
                                nearbyPeers.addAll(peerList.deviceList)
                            }
                        } catch (_: Exception) {}
                    }
                    WifiP2pManager.WIFI_P2P_CONNECTION_CHANGED_ACTION -> {
                        val manager = wifiP2pManager ?: return
                        val channel = wifiChannel ?: return
                        try {
                            manager.requestConnectionInfo(channel) { info ->
                                if (info != null && info.groupFormed) {
                                    connectedHostIp = info.groupOwnerAddress?.hostAddress ?: ""
                                    isGroupOwner = info.isGroupOwner
                                    p2pStatusText = if (info.isGroupOwner) "Host Ready" else "Linked to Host"
                                }
                            }
                        } catch (_: Exception) {}
                    }
                }
            }
        }
        registerReceiver(p2pReceiver, filter)
    }

    override fun onPause() {
        super.onPause()
        p2pReceiver?.let {
            try {
                unregisterReceiver(it)
            } catch (_: Exception) {}
        }
    }
}

@Composable
fun SafeP2PMainApp(
    isDarkTheme: Boolean,
    onToggleTheme: () -> Unit,
    isHindi: Boolean,
    onToggleLang: () -> Unit,
    peers: List<WifiP2pDevice>,
    p2pStatus: String,
    detectedHostIp: String,
    isGroupOwner: Boolean,
    onStartDiscovery: () -> Unit,
    onConnectPeer: (WifiP2pDevice) -> Unit
) {
    val context = LocalContext.current
    val scope = rememberCoroutineScope()

    var currentScreen by remember { mutableStateOf("HOME") }
    var selectedFile by remember { mutableStateOf<SelectedFileInfo?>(null) }
    var isHashing by remember { mutableStateOf(false) }

    // Milestone 4 Transfer States
    var targetIpInput by remember(detectedHostIp) {
        mutableStateOf(if (detectedHostIp.isNotEmpty()) detectedHostIp else "192.168.49.1")
    }
    var transferProgress by remember { mutableStateOf(0f) }
    var transferStatus by remember { mutableStateOf("") }
    var transferSpeed by remember { mutableStateOf("") }
    var isTransferring by remember { mutableStateOf(false) }
    var isReceivingServerOn by remember { mutableStateOf(false) }

    val historyList = remember { mutableStateListOf<TransferRecord>() }

    // Permissions Launcher for Milestone 3 Wi-Fi Direct
    val permissionLauncher = rememberLauncherForActivityResult(
        ActivityResultContracts.RequestMultiplePermissions()
    ) {
        onStartDiscovery()
    }

    fun requestP2pPermissionsAndScan() {
        val perms = mutableListOf(
            Manifest.permission.ACCESS_FINE_LOCATION,
            Manifest.permission.ACCESS_COARSE_LOCATION
        )
        if (Build.VERSION.SDK_INT >= 33) {
            perms.add("android.permission.NEARBY_WIFI_DEVICES")
        }
        val allGranted = perms.all {
            ContextCompat.checkSelfPermission(context, it) == PackageManager.PERMISSION_GRANTED
        }
        if (allGranted) {
            onStartDiscovery()
        } else {
            permissionLauncher.launch(perms.toTypedArray())
        }
    }

    // Milestone 2 SAF File Picker Launcher
    val filePickerLauncher = rememberLauncherForActivityResult(
        contract = ActivityResultContracts.OpenDocument()
    ) { uri: Uri? ->
        if (uri != null) {
            isHashing = true
            currentScreen = "SEND"
            scope.launch {
                val info = extractFileDetailsAndHash(context, uri)
                selectedFile = info
                isHashing = false
            }
        }
    }

    Scaffold(
        topBar = {
            Row(
                modifier = Modifier
                    .fillMaxWidth()
                    .background(MaterialTheme.colorScheme.surface)
                    .padding(horizontal = 16.dp, vertical = 12.dp),
                verticalAlignment = Alignment.CenterVertically,
                horizontalArrangement = Arrangement.SpaceBetween
            ) {
                Row(
                    verticalAlignment = Alignment.CenterVertically,
                    modifier = Modifier.weight(1f)
                ) {
                    Box(
                        modifier = Modifier
                            .size(42.dp)
                            .clip(RoundedCornerShape(12.dp))
                            .background(
                                Brush.linearGradient(
                                    listOf(Color(0xFF6366F1), Color(0xFFA855F7))
                                )
                            ),
                        contentAlignment = Alignment.Center
                    ) {
                        Icon(
                            imageVector = Icons.Default.Share,
                            contentDescription = null,
                            tint = Color.White
                        )
                    }
                    Spacer(modifier = Modifier.width(12.dp))
                    Column {
                        Text(
                            text = "Safe P2P India",
                            fontSize = 18.sp,
                            fontWeight = FontWeight.Bold,
                            color = MaterialTheme.colorScheme.onSurface
                        )
                        Text(
                            text = if (isHindi) "100% ऑफ़लाइन P2P (Milestone 2-4 सक्रिय)" else "100% Offline P2P (Milestones 2-4 Active)",
                            fontSize = 11.sp,
                            color = MaterialTheme.colorScheme.onSurfaceVariant,
                            maxLines = 1,
                            overflow = TextOverflow.Ellipsis
                        )
                    }
                }

                Row(verticalAlignment = Alignment.CenterVertically) {
                    TextButton(onClick = onToggleLang) {
                        Text(
                            text = if (isHindi) "EN" else "हिंदी",
                            fontWeight = FontWeight.Bold,
                            color = Color(0xFF38BDF8)
                        )
                    }
                    IconButton(onClick = onToggleTheme) {
                        Icon(
                            imageVector = if (isDarkTheme) Icons.Default.Info else Icons.Default.CheckCircle,
                            contentDescription = "Theme",
                            tint = MaterialTheme.colorScheme.onSurface
                        )
                    }
                }
            }
        },
        bottomBar = {
            NavigationBar(
                containerColor = MaterialTheme.colorScheme.surface
            ) {
                NavigationBarItem(
                    selected = currentScreen == "HOME" || currentScreen == "SEND" || currentScreen == "RECEIVE",
                    onClick = { currentScreen = "HOME" },
                    icon = { Icon(Icons.Default.Home, contentDescription = null) },
                    label = { Text(if (isHindi) "होम" else "Home") }
                )
                NavigationBarItem(
                    selected = currentScreen == "NEARBY",
                    onClick = {
                        currentScreen = "NEARBY"
                        requestP2pPermissionsAndScan()
                    },
                    icon = { Icon(Icons.Default.Place, contentDescription = null) },
                    label = { Text(if (isHindi) "आस-पास" else "Nearby") }
                )
                NavigationBarItem(
                    selected = currentScreen == "HISTORY",
                    onClick = { currentScreen = "HISTORY" },
                    icon = { Icon(Icons.Default.Refresh, contentDescription = null) },
                    label = { Text(if (isHindi) "इतिहास" else "History") }
                )
                NavigationBarItem(
                    selected = currentScreen == "SETTINGS",
                    onClick = { currentScreen = "SETTINGS" },
                    icon = { Icon(Icons.Default.Settings, contentDescription = null) },
                    label = { Text(if (isHindi) "सेटिंग्स" else "Settings") }
                )
            }
        }
    ) { innerPadding ->
        Box(
            modifier = Modifier
                .fillMaxSize()
                .padding(innerPadding)
        ) {
            when (currentScreen) {
                "HOME" -> HomeScreenContent(
                    isHindi = isHindi,
                    p2pStatus = p2pStatus,
                    selectedFile = selectedFile,
                    onSendClick = {
                        currentScreen = "SEND"
                        filePickerLauncher.launch(arrayOf("*/*"))
                    },
                    onReceiveClick = {
                        currentScreen = "RECEIVE"
                    },
                    onNearbyClick = {
                        currentScreen = "NEARBY"
                        requestP2pPermissionsAndScan()
                    }
                )

                "SEND" -> SendFileScreenM2ToM4(
                    isHindi = isHindi,
                    selectedFile = selectedFile,
                    isHashing = isHashing,
                    targetIp = targetIpInput,
                    onTargetIpChange = { targetIpInput = it },
                    peers = peers,
                    onPickFile = { filePickerLauncher.launch(arrayOf("*/*")) },
                    onScanPeers = { requestP2pPermissionsAndScan() },
                    onConnectPeer = onConnectPeer,
                    isTransferring = isTransferring,
                    progress = transferProgress,
                    statusText = transferStatus,
                    speedText = transferSpeed,
                    onStartSendSocket = {
                        val fileToSend = selectedFile ?: return@SendFileScreenM2ToM4
                        if (isTransferring) return@SendFileScreenM2ToM4
                        isTransferring = true
                        transferProgress = 0f
                        transferStatus = if (isHindi) "कनेक्ट हो रहा है..." else "Connecting..."
                        scope.launch {
                            sendFileOverSocket(
                                context = context,
                                fileInfo = fileToSend,
                                hostIp = targetIpInput.trim(),
                                port = 8988,
                                onProgress = { prog, spd, msg ->
                                    transferProgress = prog
                                    transferSpeed = spd
                                    transferStatus = msg
                                },
                                onComplete = { success, msg ->
                                    isTransferring = false
                                    transferStatus = msg
                                    if (success) {
                                        historyList.add(
                                            0,
                                            TransferRecord(
                                                fileName = fileToSend.name,
                                                sizeText = formatFileSize(fileToSend.sizeBytes),
                                                direction = "SENT",
                                                verified = true,
                                                pathOrNote = "Sent to $targetIpInput"
                                            )
                                        )
                                    }
                                }
                            )
                        }
                    },
                    onBack = { currentScreen = "HOME" }
                )

                "RECEIVE" -> ReceiveFileScreenM3ToM4(
                    isHindi = isHindi,
                    localIp = getLocalIpAddress().ifEmpty { "192.168.49.1" },
                    p2pStatus = p2pStatus,
                    isServerRunning = isReceivingServerOn,
                    progress = transferProgress,
                    statusText = transferStatus,
                    speedText = transferSpeed,
                    onStartServer = {
                        if (isReceivingServerOn) return@ReceiveFileScreenM3ToM4
                        requestP2pPermissionsAndScan()
                        isReceivingServerOn = true
                        transferProgress = 0f
                        transferStatus = if (isHindi) "पोर्ट 8988 पर फ़ाइल की प्रतीक्षा में..." else "Waiting for file on Port 8988..."
                        scope.launch {
                            receiveFileServerSocket(
                                context = context,
                                port = 8988,
                                onProgress = { prog, spd, msg ->
                                    transferProgress = prog
                                    transferSpeed = spd
                                    transferStatus = msg
                                },
                                onComplete = { success, record, msg ->
                                    isReceivingServerOn = false
                                    transferStatus = msg
                                    if (success && record != null) {
                                        historyList.add(0, record)
                                    }
                                }
                            )
                        }
                    },
                    onBack = { currentScreen = "HOME" }
                )

                "NEARBY" -> NearbyPeersScreenM3(
                    isHindi = isHindi,
                    peers = peers,
                    p2pStatus = p2pStatus,
                    detectedHostIp = detectedHostIp,
                    isGroupOwner = isGroupOwner,
                    onRescan = { requestP2pPermissionsAndScan() },
                    onConnectPeer = onConnectPeer,
                    onGoSend = { currentScreen = "SEND" },
                    onGoReceive = { currentScreen = "RECEIVE" }
                )

                "HISTORY" -> HistoryScreenM4(
                    isHindi = isHindi,
                    records = historyList,
                    onBack = { currentScreen = "HOME" }
                )

                "SETTINGS" -> SettingsScreenInfo(
                    isHindi = isHindi,
                    onBack = { currentScreen = "HOME" }
                )
            }
        }
    }
}


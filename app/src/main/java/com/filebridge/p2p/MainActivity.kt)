// --- Helper Functions for Milestone 2 (SAF + SHA-256) & Milestone 4 (Sockets) ---

suspend fun extractFileDetailsAndHash(context: Context, uri: Uri): SelectedFileInfo =
    withContext(Dispatchers.IO) {
        var name = "selected_file"
        var size = 0L
        try {
            context.contentResolver.query(uri, null, null, null, null)?.use { cursor ->
                val nameIndex = cursor.getColumnIndex(OpenableColumns.DISPLAY_NAME)
                val sizeIndex = cursor.getColumnIndex(OpenableColumns.SIZE)
                if (cursor.moveToFirst()) {
                    if (nameIndex != -1) name = cursor.getString(nameIndex) ?: name
                    if (sizeIndex != -1) size = cursor.getLong(sizeIndex)
                }
            }
        } catch (_: Exception) {}

        val digest = MessageDigest.getInstance("SHA-256")
        var countedBytes = 0L
        try {
            context.contentResolver.openInputStream(uri)?.use { input ->
                val buffer = ByteArray(64 * 1024)
                var read: Int
                while (input.read(buffer).also { read = it } != -1) {
                    digest.update(buffer, 0, read)
                    countedBytes += read
                }
            }
        } catch (_: Exception) {}

        if (size <= 0L) size = countedBytes
        val hashBytes = digest.digest()
        val hexHash = hashBytes.joinToString("") { "%02x".format(it) }

        SelectedFileInfo(
            uri = uri,
            name = name,
            sizeBytes = size,
            sha256 = hexHash
        )
    }

suspend fun sendFileOverSocket(
    context: Context,
    fileInfo: SelectedFileInfo,
    hostIp: String,
    port: Int,
    onProgress: (Float, String, String) -> Unit,
    onComplete: (Boolean, String) -> Unit
) = withContext(Dispatchers.IO) {
    val socket = Socket()
    try {
        socket.connect(InetSocketAddress(hostIp, port), 10000)
        val outStream = DataOutputStream(BufferedOutputStream(socket.getOutputStream()))

        // Send Metadata Header
        outStream.writeUTF(fileInfo.name)
        outStream.writeLong(fileInfo.sizeBytes)
        outStream.writeUTF(fileInfo.sha256)
        outStream.flush()

        val startTime = System.currentTimeMillis()
        var totalSent = 0L
        val buffer = ByteArray(64 * 1024)

        context.contentResolver.openInputStream(fileInfo.uri)?.use { input ->
            var read: Int
            while (input.read(buffer).also { read = it } != -1) {
                outStream.write(buffer, 0, read)
                totalSent += read

                val elapsedSec = ((System.currentTimeMillis() - startTime) / 1000.0).coerceAtLeast(0.1)
                val mbPerSec = (totalSent / (1024.0 * 1024.0)) / elapsedSec
                val prog = if (fileInfo.sizeBytes > 0) totalSent.toFloat() / fileInfo.sizeBytes else 0.5f

                withContext(Dispatchers.Main) {
                    onProgress(
                        prog.coerceIn(0f, 1f),
                        String.format("%.2f MB/s", mbPerSec),
                        "Sending: ${formatFileSize(totalSent)} / ${formatFileSize(fileInfo.sizeBytes)}"
                    )
                }
            }
        }
        outStream.flush()

        withContext(Dispatchers.Main) {
            onProgress(1f, "Done", "✅ फ़ाइल सफलतापूर्वक भेजी गई! (SHA-256 Sent)")
            onComplete(true, "✅ फ़ाइल सफलतापूर्वक भेजी गई! (${fileInfo.name})")
        }
    } catch (e: Exception) {
        withContext(Dispatchers.Main) {
            onComplete(false, "❌ ट्रांसफर त्रुटि: ${e.localizedMessage ?: "कनेक्शन विफल"}")
        }
    } finally {
        try {
            socket.close()
        } catch (_: Exception) {}
    }
}

suspend fun receiveFileServerSocket(
    context: Context,
    port: Int,
    onProgress: (Float, String, String) -> Unit,
    onComplete: (Boolean, TransferRecord?, String) -> Unit
) = withContext(Dispatchers.IO) {
    var serverSocket: ServerSocket? = null
    try {
        serverSocket = ServerSocket(port)
        val client = serverSocket.accept()
        val inStream = DataInputStream(BufferedInputStream(client.getInputStream()))

        val fileName = inStream.readUTF()
        val fileSize = inStream.readLong()
        val expectedSha256 = inStream.readUTF()

        val outDir = context.getExternalFilesDir(Environment.DIRECTORY_DOWNLOADS) ?: context.filesDir
        val outFile = File(outDir, fileName)

        val digest = MessageDigest.getInstance("SHA-256")
        val startTime = System.currentTimeMillis()
        var totalReceived = 0L
        val buffer = ByteArray(64 * 1024)

        FileOutputStream(outFile).use { fos ->
            var read: Int
            var remaining = fileSize
            while (remaining > 0 && inStream.read(
                    buffer,
                    0,
                    minOf(buffer.size.toLong(), remaining).toInt()
                ).also { read = it } != -1
            ) {
                fos.write(buffer, 0, read)
                digest.update(buffer, 0, read)
                totalReceived += read
                remaining -= read

                val elapsedSec = ((System.currentTimeMillis() - startTime) / 1000.0).coerceAtLeast(0.1)
                val mbPerSec = (totalReceived / (1024.0 * 1024.0)) / elapsedSec
                val prog = if (fileSize > 0) totalReceived.toFloat() / fileSize else 0.5f

                withContext(Dispatchers.Main) {
                    onProgress(
                        prog.coerceIn(0f, 1f),
                        String.format("%.2f MB/s", mbPerSec),
                        "Receiving: ${formatFileSize(totalReceived)} / ${formatFileSize(fileSize)}"
                    )
                }
            }
        }

        val actualSha256 = digest.digest().joinToString("") { "%02x".format(it) }
        val verified = actualSha256.equals(expectedSha256, ignoreCase = true)

        client.close()
        withContext(Dispatchers.Main) {
            val rec = TransferRecord(
                fileName = fileName,
                sizeText = formatFileSize(fileSize),
                direction = "RECEIVED",
                verified = verified,
                pathOrNote = outFile.absolutePath
            )
            onProgress(1f, "Done", "✅ प्राप्त हुआ: $fileName")
            onComplete(
                true,
                rec,
                if (verified) "✅ फ़ाइल प्राप्त हुई और SHA-256 सत्यापित है!\nSaved: ${outFile.name}"
                else "⚠️ फ़ाइल प्राप्त हुई पर SHA-256 मेल नहीं खाया"
            )
        }
    } catch (e: Exception) {
        withContext(Dispatchers.Main) {
            onComplete(false, null, "❌ रिसीवर त्रुटि: ${e.localizedMessage ?: "बंद हो गया"}")
        }
    } finally {
        try {
            serverSocket?.close()
        } catch (_: Exception) {}
    }
}

fun formatFileSize(bytes: Long): String {
    if (bytes < 1024) return "$bytes B"
    val kb = bytes / 1024.0
    if (kb < 1024) return String.format("%.1f KB", kb)
    val mb = kb / 1024.0
    if (mb < 1024) return String.format("%.2f MB", mb)
    val gb = mb / 1024.0
    return String.format("%.2f GB", gb)
}

fun getLocalIpAddress(): String {
    try {
        val interfaces = NetworkInterface.getNetworkInterfaces()
        while (interfaces.hasMoreElements()) {
            val intf = interfaces.nextElement()
            val addrs = intf.inetAddresses
            while (addrs.hasMoreElements()) {
                val addr = addrs.nextElement()
                if (!addr.isLoopbackAddress && addr is Inet4Address) {
                    return addr.hostAddress ?: ""
                }
            }
        }
    } catch (_: Exception) {}
    return ""
}

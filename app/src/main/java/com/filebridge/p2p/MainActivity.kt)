@OptIn(ExperimentalMaterial3Api::class)
@Composable
fun MainScaffoldContainer(
    currentScreen: AppScreen,
    onNavigate: (AppScreen) -> Unit,
    strings: LocalizedStrings,
    currentLanguage: AppLanguage,
    onLanguageChange: (AppLanguage) -> Unit,
    isDarkMode: Boolean,
    onThemeToggle: (Boolean) -> Unit,
    deviceName: String,
    onDeviceNameChange: (String) -> Unit
) {
    Scaffold(
        topBar = {
            TopAppBar(
                title = {
                    Row(verticalAlignment = Alignment.CenterVertically) {
                        Box(
                            modifier = Modifier
                                .size(36.dp)
                                .clip(RoundedCornerShape(10.dp))
                                .background(AppBranding.PrimaryGradientBrush),
                            contentAlignment = Alignment.Center
                        ) {
                            Icon(
                                imageVector = Icons.Default.SwapHoriz,
                                contentDescription = null,
                                tint = Color.White,
                                modifier = Modifier.size(22.dp)
                            )
                        }
                        Spacer(modifier = Modifier.width(10.dp))
                        Column {
                            Text(
                                text = AppBranding.APP_NAME,
                                fontWeight = FontWeight.Bold,
                                fontSize = 19.sp
                            )
                            Text(
                                text = strings.offlineReadyText,
                                fontSize = 11.sp,
                                color = MaterialTheme.colorScheme.onSurfaceVariant
                            )
                        }
                    }
                },
                actions = {
                    TextButton(
                        onClick = {
                            onLanguageChange(
                                if (currentLanguage == AppLanguage.HINDI) AppLanguage.ENGLISH else AppLanguage.HINDI
                            )
                        }
                    ) {
                        Text(
                            text = if (currentLanguage == AppLanguage.HINDI) "EN" else "हिंदी",
                            fontWeight = FontWeight.Bold
                        )
                    }
                    IconButton(onClick = { onThemeToggle(!isDarkMode) }) {
                        Icon(
                            imageVector = if (isDarkMode) Icons.Default.LightMode else Icons.Default.DarkMode,
                            contentDescription = "Toggle Theme"
                        )
                    }
                }
            )
        },
        bottomBar = {
            NavigationBar {
                NavigationBarItem(
                    selected = currentScreen == AppScreen.HOME ||
                            currentScreen == AppScreen.SEND_PREPARATION ||
                            currentScreen == AppScreen.RECEIVE_PREPARATION,
                    onClick = { onNavigate(AppScreen.HOME) },
                    icon = { Icon(Icons.Default.Home, contentDescription = strings.navHome) },
                    label = { Text(strings.navHome) }
                )
                NavigationBarItem(
                    selected = currentScreen == AppScreen.NEARBY_DEVICES,
                    onClick = { onNavigate(AppScreen.NEARBY_DEVICES) },
                    icon = { Icon(Icons.Default.Radar, contentDescription = strings.navNearby) },
                    label = { Text(strings.navNearby) }
                )
                NavigationBarItem(
                    selected = currentScreen == AppScreen.TRANSFER_HISTORY,
                    onClick = { onNavigate(AppScreen.TRANSFER_HISTORY) },
                    icon = { Icon(Icons.Default.History, contentDescription = strings.navHistory) },
                    label = { Text(strings.navHistory) }
                )
                NavigationBarItem(
                    selected = currentScreen == AppScreen.SETTINGS || currentScreen == AppScreen.HELP,
                    onClick = { onNavigate(AppScreen.SETTINGS) },
                    icon = { Icon(Icons.Default.Settings, contentDescription = strings.navSettings) },
                    label = { Text(strings.navSettings) }
                )
            }
        }
    ) { innerPadding ->
        Box(
            modifier = Modifier
                .fillMaxSize()
                .padding(innerPadding)
        ) {
            when (currentScreen) {
                AppScreen.HOME -> HomeScreenContent(
                    strings = strings,
                    deviceName = deviceName,
                    onSendClick = { onNavigate(AppScreen.SEND_PREPARATION) },
                    onReceiveClick = { onNavigate(AppScreen.RECEIVE_PREPARATION) },
                    onNearbyClick = { onNavigate(AppScreen.NEARBY_DEVICES) }
                )
                AppScreen.SEND_PREPARATION -> MilestonePlaceholderScreen(
                    title = strings.sendButtonTitle,
                    subtitle = if (currentLanguage == AppLanguage.HINDI)
                        "यह स्क्रीन Milestone 2 में Android Storage Access Framework (SAF) से जुड़ेगी।"
                    else
                        "This screen connects to Android SAF in Milestone 2.",
                    icon = Icons.Default.UploadFile,
                    onBack = { onNavigate(AppScreen.HOME) }
                )
                AppScreen.RECEIVE_PREPARATION -> MilestonePlaceholderScreen(
                    title = strings.receiveButtonTitle,
                    subtitle = if (currentLanguage == AppLanguage.HINDI)
                        "यह स्क्रीन Milestone 2 और 3 में Wi-Fi Direct रिसीवर चालू करेगी।"
                    else
                        "This screen activates Wi-Fi Direct receiver in Milestones 2 & 3.",
                    icon = Icons.Default.Download,
                    onBack = { onNavigate(AppScreen.HOME) }
                )
                AppScreen.NEARBY_DEVICES -> MilestonePlaceholderScreen(
                    title = strings.navNearby,
                    subtitle = if (currentLanguage == AppLanguage.HINDI)
                        "Milestone 3 में यहाँ आस-पास के एंड्रॉइड फ़ोनों की लाइव सूची दिखेगी।"
                    else
                        "In Milestone 3, nearby Android devices will appear here.",
                    icon = Icons.Default.Radar,
                    onBack = { onNavigate(AppScreen.HOME) }
                )
                AppScreen.TRANSFER_HISTORY -> MilestonePlaceholderScreen(
                    title = strings.navHistory,
                    subtitle = if (currentLanguage == AppLanguage.HINDI)
                        "Milestone 6 में यहाँ Room Database से इतिहास दिखेगा।"
                    else
                        "In Milestone 6, transfer history backed by Room database will appear here.",
                    icon = Icons.Default.History,
                    onBack = { onNavigate(AppScreen.HOME) }
                )
                AppScreen.SETTINGS -> SettingsScreenContent(
                    strings = strings,
                    currentLanguage = currentLanguage,
                    onLanguageChange = onLanguageChange,
                    isDarkMode = isDarkMode,
                    onThemeToggle = onThemeToggle,
                    deviceName = deviceName,
                    onDeviceNameChange = onDeviceNameChange,
                    onOpenHelp = { onNavigate(AppScreen.HELP) }
                )
                AppScreen.HELP -> HelpScreenContent(
                    currentLanguage = currentLanguage,
                    onBack = { onNavigate(AppScreen.SETTINGS) }
                )
                else -> {}
            }
        }
    }
}

